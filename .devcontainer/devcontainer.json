{
	"name": "cumberland-foodstop",
	"build": {
		"dockerfile": "./Dockerfile"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"arcanis.vscode-zipfs",
				"tamasfe.even-better-toml",
				"esbenp.prettier-vscode",
				"bradlc.vscode-tailwindcss",
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"csstools.postcss"
			]
		}
	},
	"postStartCommand": "pnpm install",
	"mounts": [
		{
			"source": "${localEnv:HOME}/Library/pnpm/store",
			"target": "${containerWorkspaceFolder}/.pnpm-store",
			"type": "bind"
		}
	]
}
